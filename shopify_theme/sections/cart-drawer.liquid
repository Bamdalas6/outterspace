<!-- Cart Drawer — exact from localhost index.html lines 437-477 -->
<!-- NO free shipping bar (data-bar-enabled="false") -->
<div class="sply-drawer" data-sply-cart hidden
  data-bar-enabled="false"
  data-bar-threshold="10000"
  data-bar-reward="free shipping"
  data-upsell-enabled="true"
  data-upsell-limit="8">
  <button type="button" class="sply-drawer__scrim" data-sply-cart-close aria-label="Close cart"></button>
  <aside class="sply-drawer__panel" role="dialog" aria-modal="true" aria-label="Bag">
    <span class="sply-drawer__sync" data-sply-sync aria-hidden="true"></span>

    <!-- Free shipping bar hidden (no free shipping) -->
    <div class="sply-drawer__bar" data-sply-bar hidden>
      <p class="sply-drawer__bar-msg" data-sply-bar-msg>You're <strong class="sply-drawer__bar-amt">$100.00 away</strong> from free shipping.</p>
      <span class="sply-drawer__bar-track"><span class="sply-drawer__bar-fill" data-sply-bar-fill style="width:0%"></span></span>
    </div>

    <ul class="sply-drawer__items" data-sply-cart-items hidden data-cart-sig=""></ul>

    <div class="sply-drawer__empty" data-sply-cart-empty>
      <p class="sply-drawer__empty-text sply-muted">Your bag is empty</p>
      <button type="button" class="sply-drawer__empty-cta" data-sply-cart-close>Keep shopping</button>
    </div>

    <!-- Upsell section -->
    <div class="sply-drawer__upsell sply-border" data-sply-upsell hidden>
      <button type="button" class="sply-drawer__upsell-toggle" data-sply-upsell-toggle aria-expanded="true">
        <span class="sply-drawer__upsell-title">You may also like</span>
        <svg class="sply-drawer__upsell-caret" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
      </button>
      <div class="sply-drawer__upsell-body">
        <div class="sply-drawer__upsell-track" data-sply-upsell-track></div>
      </div>
    </div>

    <!-- Cart footer with checkout + payment details -->
    <footer class="sply-drawer__foot sply-border" data-sply-cart-foot hidden>
      <span class="sply-drawer__total"><span class="sply-muted">Total</span><span data-sply-cart-total>$0.00</span></span>
      <form action="/cart" method="post" class="sply-drawer__checkout-form">
        <button type="submit" name="checkout" class="sply-drawer__checkout">Checkout</button>
        <span class="sply-drawer__express" data-sply-express></span>
      </form>

      <!-- Payment details (no free shipping) -->
      <div class="sply-drawer__paydetails sply-border" style="margin-top: 14px; padding: 12px 14px; border-radius: 4px; font-size: 11px; line-height: 1.5; letter-spacing: 0.04em; background: rgba(128,128,128,0.06); text-transform: uppercase;">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; font-weight: 700; font-size: 11px; letter-spacing: 0.08em;">
          <span>Accepted Payments</span>
          <span style="display: flex; gap: 6px; align-items: center;">
            <svg width="22" height="15" viewBox="0 0 32 20" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="1" y="1" width="30" height="18" rx="3"/><path d="M1 7h30"/><circle cx="8" cy="14" r="1.5"/></svg>
            <svg width="22" height="15" viewBox="0 0 32 20" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="1" y="1" width="30" height="18" rx="3"/><circle cx="12" cy="10" r="5"/><circle cx="20" cy="10" r="5"/></svg>
          </span>
        </div>
        <p style="margin: 0 0 6px 0; opacity: 0.85;">Pay via Card, Bank Transfer, USSD, Apple Pay &amp; Instant Checkout.</p>
        <p style="margin: 0; opacity: 0.65; font-size: 10px;">🔒 256-Bit SSL Encrypted &amp; Verified Secure Payment</p>
      </div>
    </footer>

    <!-- Upsell fallback products for sply-cart.js — live Shopify products -->
    <script type="application/json" data-sply-upsell-fallback>[
      {%- assign upsell_prods = collections.all.products -%}
      {%- if upsell_prods == blank or upsell_prods.size == 0 -%}
        {%- for c in collections -%}
          {%- if c.products.size > 0 and upsell_prods == blank or upsell_prods.size == 0 -%}
            {%- assign upsell_prods = c.products -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
      {%- for p in upsell_prods limit: 17 -%}
        {
          "id": {{ p.id }},
          "title": {{ p.title | json }},
          "price": {{ p.price }},
          "image": {{ p.featured_image | image_url: width: 400 | json }},
          "variant": {{ p.variants.first.id }},
          "available": {{ p.available }},
          "url": {{ p.url | json }},
          "multi": {% if p.variants.size > 1 %}true{% else %}false{% endif %}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]</script>

  </aside>
</div>

{% schema %}
{
  "name": "Cart Drawer",
  "settings": []
}
{% endschema %}
