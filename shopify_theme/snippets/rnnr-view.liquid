<!-- SPLY RNNR View Snippet -->
<style data-shopify>
  html.sply-rnnr-lock, html.sply-rnnr-lock body { height: 100%; overflow: hidden; }
  html.sply-rnnr-lock body { height: 100svh; }
  html.sply-rnnr-lock .sply-main { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 1; display: flex; flex-direction: column; }
  html.sply-rnnr-lock .shopify-section { flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; height: 100%; width: 100%; }
  html.sply-rnnr-lock .shopify-section-group-header-group { position: fixed; top: 0; left: 0; right: 0; z-index: 30; display: flex; flex-direction: column; }
  html.sply-rnnr-lock .shopify-section-group-footer-group { position: fixed; bottom: 0; left: 0; right: 0; z-index: 30; }
  html.sply-rnnr-lock .sply-topbar { position: static !important; top: auto; }
</style>

<section class="sply-rnnr" data-sply-rnnr data-rnnr-autoplay="1" data-rnnr-fill="1" data-rnnr-soldlabel="Sold out">
  <span class="sply-rnnr__stage" data-rnnr-stage></span>
  <span class="sply-rnnr__mark" data-rnnr-mark>
    <span class="sply-rnnr__count" data-rnnr-count aria-live="polite"></span>
    <span class="sply-rnnr__arrow"></span>
  </span>

  <span class="sply-rnnr__grid" data-rnnr-grid>
    <ul class="sply-rnnr__gridlist" style="--cols:6;--mcols:3">
      {% paginate collection.products by 50 %}
        {% for product in collection.products %}
          {%- assign img1 = product.featured_image | default: product.featured_media -%}
          {%- assign img2 = product.images[1] | default: img1 -%}
          <li class="sply-card">
            <a href="{{ product.url }}" class="sply-card__link" data-sply-handle="{{ product.handle }}">
              <span class="sply-card__media">
                <img class="sply-card__img sply-card__img--1" src="{{ img1 | image_url: width: 600 }}" alt="{{ product.title | escape }}" loading="lazy" width="600" height="600">
                <img class="sply-card__img sply-card__img--2" src="{{ img2 | image_url: width: 600 }}" alt="" loading="lazy" width="600" height="600" aria-hidden="true">
              </span>
              <span class="sply-card__name sply-card__name--title">{{ product.title }}</span>
              {%- if product.compare_at_price > product.price -%}
                <span class="sply-card__price sply-card__price--sale"><span class="sply-card__price-now">{{ product.price | money_without_trailing_zeros | strip_html }}</span><s class="sply-card__price-was">{{ product.compare_at_price | money_without_trailing_zeros | strip_html }}</s></span>
              {%- else -%}
                <span class="sply-card__price">{{ product.price | money_without_trailing_zeros | strip_html }}</span>
              {%- endif -%}
            </a>
          </li>
        {% else %}
          {% for product in collections.all.products limit: 50 %}
            {%- assign img1 = product.featured_image | default: product.featured_media -%}
            {%- assign img2 = product.images[1] | default: img1 -%}
            <li class="sply-card">
              <a href="{{ product.url }}" class="sply-card__link" data-sply-handle="{{ product.handle }}">
                <span class="sply-card__media">
                  <img class="sply-card__img sply-card__img--1" src="{{ img1 | image_url: width: 600 }}" alt="{{ product.title | escape }}" loading="lazy" width="600" height="600">
                  <img class="sply-card__img sply-card__img--2" src="{{ img2 | image_url: width: 600 }}" alt="" loading="lazy" width="600" height="600" aria-hidden="true">
                </span>
                <span class="sply-card__name sply-card__name--title">{{ product.title }}</span>
                {%- if product.compare_at_price > product.price -%}
                  <span class="sply-card__price sply-card__price--sale"><span class="sply-card__price-now">{{ product.price | money_without_trailing_zeros | strip_html }}</span><s class="sply-card__price-was">{{ product.compare_at_price | money_without_trailing_zeros | strip_html }}</s></span>
                {%- else -%}
                  <span class="sply-card__price">{{ product.price | money_without_trailing_zeros | strip_html }}</span>
                {%- endif -%}
              </a>
            </li>
          {% endfor %}
        {% endfor %}
      {% endpaginate %}
    </ul>
  </span>

  <!-- Exact RNNR data JSON for sply-rnnr.js engine -->
  <script type="application/json" data-rnnr-data>[
    {%- assign has_products = false -%}
    {%- for product in collection.products limit: 50 -%}
      {%- assign has_products = true -%}
      {%- assign img1 = product.featured_image | default: product.featured_media -%}
      {%- assign img2 = product.images[1] | default: img1 -%}
      {
        "title": {{ product.title | json }},
        "url": {{ product.url | json }},
        "handle": {{ product.handle | json }},
        "price": {{ product.price | money_without_trailing_zeros | strip_html | json }},
        "sold": {% if product.available %}false{% else %}true{% endif %},
        "imgs": [
          {{ img1 | image_url: width: 1200 | json }},
          {{ img2 | image_url: width: 1200 | json }}
        ]
      }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
    {%- unless has_products -%}
      {%- for product in collections.all.products limit: 50 -%}
        {%- assign img1 = product.featured_image | default: product.featured_media -%}
        {%- assign img2 = product.images[1] | default: img1 -%}
        {
          "title": {{ product.title | json }},
          "url": {{ product.url | json }},
          "handle": {{ product.handle | json }},
          "price": {{ product.price | money_without_trailing_zeros | strip_html | json }},
          "sold": {% if product.available %}false{% else %}true{% endif %},
          "imgs": [
            {{ img1 | image_url: width: 1200 | json }},
            {{ img2 | image_url: width: 1200 | json }}
          ]
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    {%- endunless -%}
  ]</script>
</section>
