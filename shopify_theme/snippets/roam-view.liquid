<!-- SPLY ROAM View Snippet -->
<style data-shopify>
  html.sply-roam-lock, html.sply-roam-lock body { height: 100%; overflow: hidden; }
  html.sply-roam-lock body { height: 100svh; }
  html.sply-roam-lock .sply-main { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 1; display: flex; flex-direction: column; }
  html.sply-roam-lock .shopify-section { flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; height: 100%; width: 100%; }
  html.sply-roam-lock .shopify-section-group-header-group { position: fixed; top: 0; left: 0; right: 0; z-index: 30; display: flex; flex-direction: column; }
  html.sply-roam-lock .shopify-section-group-footer-group { position: fixed; bottom: 0; left: 0; right: 0; z-index: 30; }
  html.sply-roam-lock .sply-topbar { position: static !important; top: auto; }
</style>

<section class="sply-roam" data-sply-roam>
  <div class="sply-roam__stage" data-roam-stage></div>
  <div class="sply-roam__grid" data-roam-grid>
    <ul class="sply-roam__gridlist" style="--cols:6;--mcols:3">
      {% paginate collection.products by 50 %}
        {% for product in collection.products %}
          {%- assign img1 = product.featured_image | default: product.featured_media -%}
          {%- assign img2 = product.images[1] | default: img1 -%}
          <li class="sply-card">
            <a href="{{ product.url }}" class="sply-card__link" data-sply-handle="{{ product.handle }}">
              <span class="sply-card__media">
                <img class="sply-card__img sply-card__img--1" src="{{ img1 | image_url: width: 600 }}" alt="{{ product.title | escape }}" loading="lazy" width="600" height="600">
                <img class="sply-card__img sply-card__img--2" src="{{ img2 | image_url: width: 600 }}" alt="" loading="lazy" width="600" height="600" aria-hidden="true">
              </span>
              <span class="sply-card__name sply-card__name--title">{{ product.title }}</span>
              {%- if product.compare_at_price > product.price -%}
                <span class="sply-card__price sply-card__price--sale"><span class="sply-card__price-now">{{ product.price | money_without_trailing_zeros | strip_html }}</span><s class="sply-card__price-was">{{ product.compare_at_price | money_without_trailing_zeros | strip_html }}</s></span>
              {%- else -%}
                <span class="sply-card__price">{{ product.price | money_without_trailing_zeros | strip_html }}</span>
              {%- endif -%}
            </a>
          </li>
        {% else %}
          {% for product in collections.all.products limit: 50 %}
            {%- assign img1 = product.featured_image | default: product.featured_media -%}
            {%- assign img2 = product.images[1] | default: img1 -%}
            <li class="sply-card">
              <a href="{{ product.url }}" class="sply-card__link" data-sply-handle="{{ product.handle }}">
                <span class="sply-card__media">
                  <img class="sply-card__img sply-card__img--1" src="{{ img1 | image_url: width: 600 }}" alt="{{ product.title | escape }}" loading="lazy" width="600" height="600">
                  <img class="sply-card__img sply-card__img--2" src="{{ img2 | image_url: width: 600 }}" alt="" loading="lazy" width="600" height="600" aria-hidden="true">
                </span>
                <span class="sply-card__name sply-card__name--title">{{ product.title }}</span>
                {%- if product.compare_at_price > product.price -%}
                  <span class="sply-card__price sply-card__price--sale"><span class="sply-card__price-now">{{ product.price | money_without_trailing_zeros | strip_html }}</span><s class="sply-card__price-was">{{ product.compare_at_price | money_without_trailing_zeros | strip_html }}</s></span>
                {%- else -%}
                  <span class="sply-card__price">{{ product.price | money_without_trailing_zeros | strip_html }}</span>
                {%- endif -%}
              </a>
            </li>
          {% endfor %}
        {% endfor %}
      {% endpaginate %}
    </ul>
  </div>

  <!-- Exact ROAM data JSON for sply-roam.js engine -->
  <script type="application/json" data-roam-data>[
    {%- assign has_roam_prods = false -%}
    {%- for product in collection.products limit: 50 -%}
      {%- assign has_roam_prods = true -%}
      {%- assign img1 = product.featured_image | default: product.featured_media -%}
      {
        "img": {{ img1 | image_url: width: 1200 | json }},
        "title": {{ product.title | json }},
        "price": {{ product.price | money_without_trailing_zeros | strip_html | json }},
        {%- if product.compare_at_price > product.price -%}
          "was": {{ product.compare_at_price | money_without_trailing_zeros | strip_html | json }},
        {%- endif -%}
        "url": {{ product.url | json }},
        "sold": {% if product.available %}false{% else %}true{% endif %},
        "feat": {% if product.tags contains 'roam-featured' or forloop.first or forloop.index == 3 or forloop.index == 5 or forloop.index == 7 or forloop.index == 9 or forloop.index == 11 or forloop.index == 13 or forloop.index == 15 or forloop.index == 17 %}true{% else %}false{% endif %}
      }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
    {%- unless has_roam_prods -%}
      {%- for product in collections.all.products limit: 50 -%}
        {%- assign img1 = product.featured_image | default: product.featured_media -%}
        {
          "img": {{ img1 | image_url: width: 1200 | json }},
          "title": {{ product.title | json }},
          "price": {{ product.price | money_without_trailing_zeros | strip_html | json }},
          {%- if product.compare_at_price > product.price -%}
            "was": {{ product.compare_at_price | money_without_trailing_zeros | strip_html | json }},
          {%- endif -%}
          "url": {{ product.url | json }},
          "sold": {% if product.available %}false{% else %}true{% endif %},
          "feat": {% if product.tags contains 'roam-featured' or forloop.first or forloop.index == 3 or forloop.index == 5 or forloop.index == 7 or forloop.index == 9 or forloop.index == 11 or forloop.index == 13 or forloop.index == 15 or forloop.index == 17 %}true{% else %}false{% endif %}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    {%- endunless -%}
  ]</script>
</section>
